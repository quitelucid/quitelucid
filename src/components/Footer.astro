---
const today = new Date();
---

<footer>
	<p class="tagline">🌍 Chaque geste compte — jouez, apprenez, agissez.</p>
	<p class="legal">
		&copy; {today.getFullYear()} Quite Lucid · Illustrations sous licence{' '}
		<a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.fr">CC BY-NC-SA 4.0</a>
		{' '}·{' '}
		<a href="https://github.com/quitelucid/quitelucid.github.io">GitHub</a>
	</p>
</footer>
<style>
	footer {
		border-top: 3px solid var(--ink);
		background: var(--green);
		color: #eaf5ee;
		text-align: center;
		padding: 1.75rem 1rem 2rem;
	}
	.tagline {
		font-weight: 700;
		margin-bottom: 0.4rem;
	}
	.legal {
		margin: 0;
		font-size: 0.85rem;
		opacity: 0.85;
	}
	footer a {
		color: var(--sun);
	}
</style>
